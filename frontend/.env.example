# Optional. Defaults to the public Base Sepolia RPC. Use an Alchemy/Infura URL for reliability during the demo.
VITE_RPC_URL=https://sepolia.base.org
# Optional. Backend base URL. Leave empty to disable backend widgets.
VITE_API_URL=http://localhost:4000
# Optional. Gateway used to open ipfs:// receipt links.
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
