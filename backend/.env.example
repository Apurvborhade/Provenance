PORT=4000
# URL clients use to reach this server; goes into on-chain receipt URIs. Use your LAN IP / tunnel URL for the demo.
PUBLIC_URL=http://localhost:4000
DATABASE_URL="file:./dev.db"
RPC_URL=https://sepolia.base.org
# Fill after Apurva deploys
CONTRACT_ADDRESS=0xd38Fa0f8932025b5a8F996b5DE76e0a8480D5280
CONTRACT_DEPLOY_BLOCK=46956091
INDEXER_POLL_MS=10000
INDEXER_ENABLED=true

# --- Receipt storage (proof-of-spend) ---
# Pinata JWT from https://app.pinata.cloud/developers/api-keys (free tier). When set, receipts are pinned to IPFS
# and `ipfs://<cid>` is written on-chain. Leave empty to store on local disk instead.
PINATA_JWT=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
IPFS_TIMEOUT_MS=30000
# If pinning fails, fall back to local disk instead of failing the upload (keeps the demo alive).
IPFS_FALLBACK_LOCAL=true
