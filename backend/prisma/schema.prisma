// Owner: Aditya. Spec: docs/04-BACKEND.md
// SQLite for zero-infra hackathon. To use Postgres: provider = "postgresql", DATABASE_URL=postgres://...
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Mirrors an on-chain org (OrgCreated / OrgUpdated events).
model Org {
  id           Int      @id            // on-chain orgId
  owner        String
  name         String
  description  String
  createdAt    Int                     // unix seconds (block timestamp)
  createTxHash String
  updatedAt    DateTime @updatedAt

  donations  Donation[]
  milestones Milestone[]
}

/// One row per Donated event. Amounts are wei as strings (no 256-bit ints in SQLite / JS number).
model Donation {
  txHash      String   @id
  logIndex    Int
  orgId       Int
  donor       String
  amount      String
  message     String   @default("")
  blockNumber Int
  timestamp   Int
  createdAt   DateTime @default(now())

  org Org @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([donor])
  @@index([blockNumber])
}

/// Mirrors an on-chain milestone + the tx hash for each lifecycle step. Ids are scoped per org.
model Milestone {
  orgId         Int
  id            Int                     // on-chain milestoneId (per org)
  description   String
  amount        String                  // wei
  status        String   @default("pending") // pending | approved | released
  createdAt     Int                     // unix seconds (block timestamp)
  releasedAt    Int?
  payee         String                  // receives funds on release
  requestTxHash String
  approveTxHash String?
  releaseTxHash String?
  proofHash     String?                 // keccak256 hex, set by ProofAttached
  proofUri      String?
  proofAt       Int?
  proofTxHash   String?
  updatedAt     DateTime @updatedAt

  org      Org                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  metadata MilestoneMetadata?

  @@id([orgId, id])
}

/// Off-chain only: receipt links / notes attached by the org.
model MilestoneMetadata {
  orgId       Int
  milestoneId Int
  receiptUrl  String?
  notes       String?
  updatedAt   DateTime @updatedAt

  milestone Milestone @relation(fields: [orgId, milestoneId], references: [orgId, id], onDelete: Cascade)

  @@id([orgId, milestoneId])
}

/// Single-row cursor so the indexer resumes where it left off.
model IndexerState {
  id        Int @id @default(1)
  lastBlock Int
}
